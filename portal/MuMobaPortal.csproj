<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The public web of the server (account creation, ranking, server status, news). Standalone: it only talks to the game database. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MuMoba.Portal</RootNamespace>
    <AssemblyName>MuMobaPortal</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>

</Project>
